{"SurveyID":"SV_9MHtNAQuGij1DTg","Element":"SQ","PrimaryAttribute":"QID4249","SecondaryAttribute":"IWAHQ2_wordWe","TertiaryAttribute":null,"Payload":{"AnswerOrder":[1,2,3,4,5],"Answers":{"1":{"Display":"almost never"},"2":{"Display":"rarely"},"3":{"Display":"occasionally"},"4":{"Display":"often"},"5":{"Display":"very often"}},"ChoiceDataExportTags":false,"ChoiceOrder":["1","2","3"],"Choices":{"1":{"Display":"People in my community"},"2":{"Display":"People in my country"},"3":{"Display":"People all over the world"}},"Configuration":{"ChoiceColumnWidth":25,"MobileFirst":true,"QuestionDescriptionOption":"SpecifyLabel","RepeatHeaders":"none","TextPosition":"inline","WhiteSpace":"OFF"},"DataExportTag":"IWAH_wordWe","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":6,"NextChoiceId":4,"QuestionDescription":"IWAHQ2_wordWe","QuestionID":"QID4249","QuestionText":"How often do you use the word \u201cwe\u201d to refer to the following groups of people?","QuestionText_Unsafe":"How often do you use the word \u201cwe\u201d to refer to the following groups of people?","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},
