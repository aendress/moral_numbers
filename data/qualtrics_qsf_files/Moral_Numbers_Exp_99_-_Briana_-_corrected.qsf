{"SurveyID":"SV_2t4UF1nJSAUJ3My","Element":"SQ","PrimaryAttribute":"QID4286","SecondaryAttribute":"EMCSQ19_sellLaptop","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2],"Choices":{"1":{"Display":"I keep my promise."},"2":{"Display":"I sell the laptop for more money."}},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"DataExportTag":"EMCS_sellLaptop","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":3,"QuestionDescription":"EMCSQ19_sellLaptop","QuestionID":"QID4286","QuestionText":"I want to sell my old laptop. As my uncle hears about it, he offers to pay \u00a3200 and I agree. Soon after, I see on an internet portal that I could sell the laptop immediately for \u00a3300 there. What do I do?","QuestionText_Unsafe":"I want to sell my old laptop. As my uncle hears about it, he offers to pay \u00a3200 and I agree. Soon after, I see on an internet portal that I could sell the laptop immediately for \u00a3300 there. What do I do?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},
{"SurveyID":"SV_2t4UF1nJSAUJ3My","Element":"SQ","PrimaryAttribute":"QID4268","SecondaryAttribute":"EMCSQ1_concertTicketpricing","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2],"Choices":{"1":{"Display":"I take the more expensive ticket."},"2":{"Display":"I take the cheaper ticket."}},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"DataExportTag":"EMCS_concertTicketpr","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":3,"QuestionDescription":"EMCSQ1_concertTicketpricing","QuestionID":"QID4268","QuestionText":"I buy concert tickets on the internet for my brother and myself. I can get two seats side by side. However, the tickets fall into two different price categories, so that one ticket is \u00a310 more expensive than the other. What do I do?","QuestionText_Unsafe":"I buy concert tickets on the internet for my brother and myself. I can get two seats side by side. However, the tickets fall into two different price categories, so that one ticket is \u00a310 more expensive than the other. What do I do?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},
