{"SurveyID":"SV_2t4UF1nJSAUJ3My","Element":"SQ","PrimaryAttribute":"QID4274","SecondaryAttribute":"EMCSQ7_babysitVSparty","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2],"Choices":{"1":{"Display":"I keep my promise."},"2":{"Display":"I think up an excuse."}},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"DataExportTag":"EMCS_babysitVSparty\u00a0","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":3,"QuestionDescription":"EMCSQ7_babysitVSparty","QuestionID":"QID4274","QuestionText":"I have promised my sister to take care of her children tonight. Now, I realize that I am also invited to a farewell party today that is very important for me. I could think up an excuse to go to the party. What do I do?","QuestionText_Unsafe":"I have promised my sister to take care of her children tonight. Now, I realize that I am also invited to a farewell party today that is very important for me. I could think up an excuse to go to the party. What do I do?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},
